{
  "name": "mcp-server-excalidraw",
  "version": "1.0.0",
  "description": "MCP server for Excalidraw diagram automation — generate Azure architecture diagrams via Copilot CLI or any MCP client. Cross-platform, no native dependencies.",
  "type": "module",
  "bin": {
    "mcp-server-excalidraw": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "build:icons": "tsx scripts/build-azure-icons.ts"
  },
  "keywords": [
    "mcp",
    "excalidraw",
    "azure",
    "architecture",
    "diagrams",
    "copilot",
    "model-context-protocol",
    "cross-platform"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "sharp": "^0.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md",
    "STYLE_GUIDE.md"
  ]
}
